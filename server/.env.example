# --- Segment 2: core server config ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string.
# Get this from Atlas: Database > Connect > Drivers > Node.js,
# then swap in your DB user's username/password and a database name.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- Segment 3: auth ---
# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Segment 5: image upload ---
# From your Cloudinary dashboard (Settings > Access Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Added in later segments (not yet used) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EMAIL_FROM=
# RESEND_API_KEY=
