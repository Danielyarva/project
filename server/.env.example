# --- Segment 2: core server config ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string.
# Get this from Atlas: Database > Connect > Drivers > Node.js,
# then swap in your DB user's username/password and a database name.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- Segment 3: auth ---
# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Segment 5: image upload ---
# From your Cloudinary dashboard (Settings > Access Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Segment 6: contact form email notifications ---
# From your Resend dashboard (resend.com/api-keys)
RESEND_API_KEY=
# Must be a verified sender on your Resend account/domain.
# Resend's shared testing address works with no domain setup: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev
# Where contact form submissions get emailed (your business inbox)
CONTACT_NOTIFY_EMAIL=

# --- Segment 11: payments ---
# Test-mode secret key from your Stripe dashboard (starts with sk_test_)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint's signing secret in
# the Stripe dashboard once deployed (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
